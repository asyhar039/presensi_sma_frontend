{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false,
    "defaultBranch": "master"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules/*",
      "!**/build/*",
      "!**/dist/*",
      "!**/vendor/*",
      "!**/temp/*",
      "!**/tmp/*",
      "!**/.tanstack",
      "!**/src/routeTree.gen.ts",
      "!**/temp/*"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "attributePosition": "auto"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "javascript": {
    "globals": ["Bun", "React"],
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "quoteStyle": "single",
      "attributePosition": "auto"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "lexicographic",
            "groups": [
              {
                "type": true
              },
              ":BLANK_LINE:",
              [":URL:", ":NODE:", ":PACKAGE:"],
              ":BLANK_LINE:",
              ["@/layouts/**", "@/routes/**"],
              ":BLANK_LINE:",
              ["@/**"]
            ]
          }
        }
      }
    }
  }
}
