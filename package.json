{
  "name": "fe-plant-factory",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "NODE_ENV=production && bunx --bun tsc -b && bunx --bun vite build --mode production",
    "build:analyze": "NODE_ENV=production && bunx --bun tsc && bunx --bun vite build --mode analyze",
    "preview": "bunx --bun vite preview",
    "lint": "bunx --bun biome lint .",
    "format": "bunx --bun biome format . --write",
    "types": "bunx --bun tsc -b",
    "check": "bunx --bun biome check .",
    "check:write": "bunx --bun biome check . --write",
    "check:unsafe": "bunx --bun biome check . --write --unsafe",
    "fix": "bun run check:unsafe && bun run lint",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-form-devtools": "^0.2.29",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-table": "^9.2.4",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.21",
    "fuse.js": "^7.5.0",
    "js-cookie": "^3.0.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-vite": "^0.8.0",
    "@tanstack/react-devtools": "^0.10.7",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "lefthook": "^2.1.9",
    "typescript": "~6",
    "vite": "^8",
    "vite-bundle-analyzer": "^1.3.8",
    "vite-plugin-minify": "^3.0.0"
  }
}
